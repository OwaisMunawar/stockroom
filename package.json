{
  "name": "stockroom",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "description": "Offline cycle counts with reviewed drafts, durable sync and explicit conflict resolution.",
  "author": "Owais Munawwar <owais.munawar@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "server": "tsx server/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "doctor": "expo-doctor",
    "verify:server": "tsx tool/verify-server.ts"
  },
  "dependencies": {
    "expo": "~57.0.31",
    "expo-constants": "~57.0.21",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "babel-jest": "~29.7.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "expo-doctor": "1.20.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  }
}
