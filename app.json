{
  "expo": {
    "name": "Stockroom",
    "slug": "stockroom",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.owaismunawar.stockroom",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.owaismunawar.stockroom"
    },
    "plugins": ["expo-sqlite"],
    "icon": "./assets/icon.png"
  }
}
